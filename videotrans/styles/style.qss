/* ==========================================================================
   Tinix Video Dubbing - HubSpot Inspired Design System (QSS)
   Primary CTA: #FF4800 (HubSpot Orange) | Hover: #C93700 | Active: #9F2800
   Secondary Accent: #124548 (Teal Dark) | #2F7579 (Teal Medium) | #CAEBFF
   Surface: #19232D / #161E26 | Borders: #455364 / #CFCCCB
   ========================================================================== */

* {
    font-family: "Segoe UI", "Helvetica Neue", "Arial", sans-serif;
    font-size: 13px;
    padding: 0px;
    margin: 0px;
    border: 0px;
    outline: 0;
}

QWidget {
    background-color: #19232D;
    color: #DFE1E2;
    selection-background-color: #124548;
    selection-color: #FFFFFF;
}

QWidget:disabled {
    background-color: #19232D;
    color: #788D9C;
    selection-background-color: #1B2936;
    selection-color: #788D9C;
}

/* --- Main Window & Separators --- */
QMainWindow::separator {
    background-color: #32414B;
    width: 3px;
    height: 3px;
}

QMainWindow::separator:hover {
    background-color: #FF4800;
}

/* --- Menu Bar & Menus --- */
QMenuBar {
    background-color: #212C36;
    padding: 3px 6px;
    border-bottom: 1px solid #32414B;
    color: #DFE1E2;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #124548;
    color: #FFFFFF;
}

QMenuBar::item:pressed {
    background-color: #2F7579;
    color: #FFFFFF;
}

QMenu {
    background-color: #212C36;
    color: #DFE1E2;
    border: 1px solid #32414B;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 28px 6px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #124548;
    color: #FFFFFF;
}

QMenu::separator {
    height: 1px;
    background-color: #32414B;
    margin: 4px 6px;
}

/* --- ToolBar & ToolButtons --- */
QToolBar {
    background-color: #212C36;
    border-bottom: 1px solid #32414B;
    padding: 2px;
    spacing: 4px;
}

QToolButton {
    background-color: #2A3844;
    color: #DFE1E2;
    border-radius: 6px;
    padding: 5px 8px;
    border: 1px solid #384956;
}

QToolButton:hover {
    background-color: #344654;
    border-color: #2F7579;
    color: #FFFFFF;
}

QToolButton:pressed, QToolButton:checked {
    background-color: #124548;
    border-color: #FF4800;
    color: #FFFFFF;
}

/* --- Buttons (HubSpot Primary & Secondary) --- */
QPushButton {
    background-color: #2A3844;
    color: #DFE1E2;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 500;
    border: 1px solid #384956;
    min-height: 22px;
}

QPushButton:hover {
    background-color: #344654;
    border-color: #2F7579;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #124548;
    border-color: #FF4800;
}

QPushButton:disabled {
    background-color: #1E2730;
    color: #607280;
    border-color: #28333E;
}

/* Primary Action Button (Start / Submit) - HubSpot Orange */
QPushButton#startbtn, QPushButton[primary="true"], QPushButton:default {
    background-color: #FF4800;
    color: #FFFFFF;
    font-weight: 600;
    border-radius: 8px;
    border: none;
    padding: 8px 18px;
}

QPushButton#startbtn:hover, QPushButton[primary="true"]:hover, QPushButton:default:hover {
    background-color: #C93700;
}

QPushButton#startbtn:pressed, QPushButton[primary="true"]:pressed, QPushButton:default:pressed {
    background-color: #9F2800;
}

QPushButton#startbtn:disabled, QPushButton[primary="true"]:disabled, QPushButton:default:disabled {
    background-color: #4A2B20;
    color: #8C7B75;
}

/* --- Text Inputs & ComboBoxes --- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QAbstractSpinBox {
    background-color: #161E26;
    color: #DFE1E2;
    border: 1px solid #384956;
    border-radius: 6px;
    padding: 4px 8px;
    min-height: 22px;
}

QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #2F7579;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #FF4800;
    background-color: #1A232D;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
    background-color: #1A222B;
    color: #607280;
    border-color: #28333E;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #384956;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QComboBox::down-arrow {
    image: url(":/qss_icons/dark/rc/arrow_down.png");
    height: 9px;
    width: 9px;
}

QComboBox QAbstractItemView {
    background-color: #212C36;
    border: 1px solid #384956;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #124548;
    selection-color: #FFFFFF;
}

/* --- Text Editors & Text Browsers --- */
QTextEdit, QPlainTextEdit, QTextBrowser {
    background-color: #161E26;
    color: #DFE1E2;
    border: 1px solid #384956;
    border-radius: 6px;
    padding: 4px;
}

QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #FF4800;
}

/* --- Progress Bar --- */
QProgressBar {
    background-color: #161E26;
    border: 1px solid #384956;
    border-radius: 6px;
    text-align: center;
    color: #FFFFFF;
    font-weight: 500;
    min-height: 18px;
}

QProgressBar::chunk {
    background-color: #FF4800;
    border-radius: 5px;
}

QProgressBar:disabled {
    background-color: #1A222B;
    border-color: #28333E;
    color: #607280;
}

/* --- Tab Widget --- */
QTabWidget::pane {
    border: 1px solid #384956;
    border-radius: 8px;
    background-color: #19232D;
    padding: 4px;
}

QTabBar::tab {
    background-color: #212C36;
    color: #B0B9C2;
    border: 1px solid #384956;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 6px 14px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background-color: #2A3844;
    color: #FFFFFF;
}

QTabBar::tab:selected {
    background-color: #19232D;
    color: #FF4800;
    border-top: 2px solid #FF4800;
    font-weight: 600;
}

/* --- Scroll Bars --- */
QScrollBar:vertical {
    background-color: #161E26;
    width: 12px;
    margin: 0px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #384956;
    min-height: 20px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #2F7579;
}

QScrollBar::handle:vertical:pressed {
    background-color: #FF4800;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #161E26;
    height: 12px;
    margin: 0px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #384956;
    min-width: 20px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #2F7579;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #FF4800;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* --- Labels & CheckBoxes --- */
QLabel {
    background: transparent;
    color: #DFE1E2;
}

QCheckBox {
    background: transparent;
    color: #DFE1E2;
    spacing: 6px;
}

QCheckBox:hover {
    color: #FFFFFF;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #455364;
    border-radius: 4px;
    background-color: #161E26;
}

QCheckBox::indicator:hover {
    border-color: #FF4800;
}

QCheckBox::indicator:checked {
    background-color: #FF4800;
    border-color: #FF4800;
    image: url(":/qss_icons/dark/rc/checkbox_checked.png");
}

/* --- Tooltips & Statusbar --- */
QToolTip {
    background-color: #124548;
    color: #FFFFFF;
    border: 1px solid #2F7579;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

QStatusBar {
    background-color: #212C36;
    color: #DFE1E2;
    border-top: 1px solid #32414B;
}
